<header class="topbar">
    <button type="button" class="hamburger" id="sidebarToggle" aria-label="Toggle sidebar" aria-controls="sidebar"><svg class="icon"><use href="#menu" /></svg></button>
    <div class="top-right">
        <div class="theme-toggle" role="group" aria-label="Theme">
            <button type="button" data-theme="light" class="selected" aria-label="Light mode"><svg class="icon"><use href="#sun" /></svg></button>
            <button type="button" data-theme="dark" aria-label="Dark mode"><svg class="icon"><use href="#moon" /></svg></button>
        </div>
        <a class="notification notification-link" href="/notifications" aria-label="Notifications"><svg class="icon" style="width:26px;height:26px"><use href="#bell" /></svg></a>
        <a class="profile" href="/profile" title="My Profile">
            <div class="avatar" aria-hidden="true">👤</div>
            <div>
                <div class="profile-name">@(User.Identity?.IsAuthenticated == true ? (User.FindFirst("display_name")?.Value ?? User.Identity.Name) : "Not signed in")</div>
                <div class="profile-role">@(User.IsInRole("Manager") ? "Manager" : User.IsInRole("Staff") ? "Staff" : "")</div>
            </div>
            <svg class="icon" style="width:14px"><use href="#chevron" /></svg>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form id="themeForm" method="post" action="/profile/theme" hidden>@Html.AntiForgeryToken()</form>
            <form asp-controller="Account" asp-action="Logout" method="post" class="signout-form">
                <button type="submit" class="btn btn-outline">Sign out</button>
            </form>
        }
    </div>
</header>
