<!doctype html>
@{ var userTheme = User.FindFirst(Netora.WebUI.Infrastructure.SessionSignIn.ThemeClaim)?.Value; }
<html lang="en" data-bs-theme="@(userTheme ?? "light")" data-user-theme="@userTheme">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>@(ViewData["Title"] ?? "Netora") | Netora MikroTik Manager</title>
    <link rel="preload" href="~/fonts/Inter-400-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/netora.css" asp-append-version="true">
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <partial name="_Icons" />
    <div class="app">
        <partial name="_Sidebar" />
        <div class="workspace">
            <partial name="_Topbar" />
            <main class="content" id="main-content" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>
    <div class="toast-area" id="toastArea" role="status" aria-live="polite"></div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
