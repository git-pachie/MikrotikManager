@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<section class="panel module-panel" aria-labelledby="error-title">
    <div class="heading">
        <div class="heading-title">
            <svg class="icon" aria-hidden="true"><use href="#pulse" /></svg>
            <div>
                <h1 id="error-title">Something went wrong</h1>
                <p>Netora couldn’t complete this request. Try again from the dashboard.</p>
            </div>
        </div>
    </div>
    @if (Model.ShowRequestId)
    {
        <p class="module-note">Reference <code>@Model.RequestId</code></p>
    }
    <div class="module-actions"><a class="btn btn-primary" href="/dashboard">Back to Dashboard</a></div>
</section>
