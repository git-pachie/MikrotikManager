@model PppoePasswordViewModel
@if (Model.PasswordSet && User.IsInRole("Manager"))
{
    <form asp-controller="Pppoe" asp-action="RevealPassword" asp-route-id="@Model.CustomerId" method="post" class="pppoe-password">
        <strong data-password-value aria-live="polite">••••••••</strong>
        <button type="submit" class="btn btn-outline">Show password</button>
        <span data-password-error class="field-error" role="alert" hidden></span>
    </form>
}
else
{
    <strong>@(Model.PasswordSet ? "Saved" : "Not saved")</strong>
}
