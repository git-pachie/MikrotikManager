@model PppoeImportViewModel
@{
    ViewData["Title"] = "Import PPPoE";
    ViewData["Nav"] = "pppoe";
    var scan = Model.Scan;
    var mode = scan?.Mode ?? Model.Router?.Mode;
    var mock = mode == "Mock";
}
@* Layout from approved-mockups/import-pppoe.html. The scan runs only when a Manager presses Scan Router (04.04),
   and nothing is imported until the selection is confirmed. *@
<div class="heading">
    <div class="heading-title">
        <svg class="icon"><use href="#users" /></svg>
        <div>
            <h1>Import Existing PPPoE</h1>
            <p>Preview existing RouterOS PPPoE secrets before importing into SQL Server.</p>
        </div>
    </div>
    <div class="heading-actions"><a class="btn btn-outline" href="/pppoe">PPPoE Management</a></div>
</div>
@if (TempData[Netora.WebUI.Controllers.CustomersController.ToastKey] is string toast)
{
    <div class="form-success" role="status">@toast</div>
}
@if (TempData[Netora.WebUI.Controllers.CustomersController.ErrorKey] is string toastError)
{
    <div class="form-alert" role="alert">@toastError</div>
}
@if (Model.Error is not null)
{
    <div class="form-alert" role="alert">@Model.Error</div>
}

<section class="panel module-panel">
    <div class="module-head">
        <h2>Import Options</h2>
        @if (mode is not null)
        {
            <span class="pill @(mock ? "pending" : "active")">@(mock ? "Mock router" : "RouterOS")</span>
        }
    </div>
    <div class="module-fields">
        <label>Scan source<input readonly value="@(mock ? "Mock router" : mode == "RouterOS" ? Model.Router?.Name ?? Model.Router?.Address ?? "MikroTik" : "Mode unavailable")"></label>
        <label>Duplicate Handling<input value="Skip existing usernames" readonly></label>
    </div>
    @if (mock)
    {
        <p class="detail-alert" role="status">This scan uses the mock router. To import from MikroTik, select RouterOS in <a href="/settings">Settings</a>, save, and run Test Connection.</p>
    }
    @if (Model.Router?.PasswordUnreadable == true)
    {
        <p class="form-alert" role="alert">Re-enter the API password in <a href="/settings">Router Settings</a> before connecting to MikroTik.</p>
    }
    <div class="module-actions">
        <form method="post" action="/pppoe/import/scan">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary" disabled="@(!Model.IsManager)" title="@(Model.IsManager ? null : "Only Managers can import")">Scan Router</button>
        </form>
        <button type="submit" form="importForm" class="btn btn-outline" disabled="@(scan is not { NewCount: > 0 })">Confirm Import</button>
    </div>
    <p class="module-note">Import preserves router settings and assigns new records to UNKNOWN NAP. Usernames linked to existing, unarchived customers are skipped.</p>
</section>

<section class="panel module-panel">
    <div class="module-head"><h2>Preview</h2>@if (scan is not null) { <span class="detail-secondary">@scan.Items.Count secret(s) on the router, @scan.NewCount new</span> }</div>
    @if (scan is null)
    {
        <div class="detail-empty">No scan yet. PPPoE secrets found on the router will be listed here for review before anything is imported.</div>
    }
    else if (scan.Items.Count == 0)
    {
        <div class="detail-empty">@(mock ? "The mock router has no PPP secrets." : "The MikroTik router returned no PPP secrets.")</div>
    }
    else
    {
        @if (scan.NewCount == 0)
        {
            <p class="module-note">No accounts are eligible to import. Review the reason shown beside each account.</p>
        }
        <form id="importForm" method="post" action="/pppoe/import" data-confirm="Import the selected accounts into Netora?">
            @Html.AntiForgeryToken()
            <input type="hidden" name="previewMode" value="@scan.Mode">
            <div class="table-scroll">
                <table class="customers-table all-table">
                    <thead><tr><th>Select</th><th>PPPoE Username</th><th>Profile</th><th>Existing SQL Record</th><th>NAP Assignment</th></tr></thead>
                    <tbody>
                        @foreach (var i in scan.Items)
                        {
                            var isNew = i.State == "New";
                            <tr>
                                <td><input type="checkbox" name="names" value="@i.Name" checked="@isNew" disabled="@(!isNew)" aria-label="Import @i.Name"></td>
                                <td>@i.Name @if (i.Disabled) { <span class="pill disabled">Disabled</span> }</td>
                                <td>@(i.Profile ?? "—")</td>
                                <td>
                                    @if (i.CustomerId is { } cid) { <a class="customer-link" href="/customers/@cid">@i.State</a> } else { @i.State }
                                    @if (i.Reason is not null && !isNew) { <span class="detail-secondary"> (@i.Reason)</span> }
                                </td>
                                <td>@(isNew ? "UNKNOWN" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    }
</section>
