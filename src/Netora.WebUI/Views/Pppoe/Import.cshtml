@{
    ViewData["Title"] = "Import PPPoE";
    ViewData["Nav"] = "pppoe";
    const string noRouter = "Needs the MikroTik router connection, which is not set up yet";
}
@* Layout from approved-mockups/import-pppoe.html. Scanning needs a RouterOS 7 router (module 09), so the actions are
   shown disabled and the preview is empty instead of showing sample secrets. *@
<div class="heading">
    <div class="heading-title">
        <svg class="icon"><use href="#users" /></svg>
        <div>
            <h1>Import Existing PPPoE</h1>
            <p>Preview existing RouterOS PPPoE secrets before importing into SQL Server.</p>
        </div>
    </div>
    <div class="heading-actions"><a class="btn btn-outline" href="/pppoe">PPPoE Management</a></div>
</div>
<section class="panel module-panel">
    <div class="module-head"><h2>Import Options</h2></div>
    <div class="module-fields">
        <label>Router<select disabled><option>No router configured</option></select></label>
        <label>Duplicate Handling<select disabled><option>Skip existing usernames</option></select></label>
    </div>
    <div class="module-actions">
        <button type="button" class="btn btn-primary" disabled title="@noRouter">Scan Router</button>
        <button type="button" class="btn btn-outline" disabled title="@noRouter">Confirm Import</button>
    </div>
    <p class="module-note">The scan is on-demand only. Import preserves router settings; new records are assigned UNKNOWN NAP until reviewed. Scanning becomes available once a MikroTik RouterOS 7 router is connected.</p>
</section>
<section class="panel module-panel">
    <div class="module-head"><h2>Preview</h2></div>
    <div class="detail-empty">No scan yet. PPPoE secrets found on the router will be listed here for review before anything is imported.</div>
</section>
