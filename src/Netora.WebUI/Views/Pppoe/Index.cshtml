@model PppoeListViewModel
@using Netora.Application.Pppoe
@{
    ViewData["Title"] = "PPPoE Management";
    ViewData["Nav"] = "pppoe";
    var data = Model.Data;
}
<div class="heading">
    <div class="heading-title">
        <svg class="icon"><use href="#users" /></svg>
        <div>
            <h1>PPPoE Management</h1>
            <p>Manage account requests, router state, and customer connections.</p>
        </div>
    </div>
    <div class="heading-actions"><a class="btn btn-outline" href="/customers">Customers</a></div>
</div>
@if (TempData[Netora.WebUI.Controllers.CustomersController.ToastKey] is string toast)
{
    <div class="form-success" role="status">@toast</div>
}
@if (TempData[Netora.WebUI.Controllers.CustomersController.ErrorKey] is string error)
{
    <div class="form-alert" role="alert">@error</div>
}
@if (data is null)
{
    <section class="panel" role="alert"><p class="mb-0" style="color:var(--muted)">@Model.ErrorMessage</p></section>
    return;
}
<section class="panel module-panel">
    <div class="module-head">
        <h2>PPPoE Accounts</h2>
        <a class="btn btn-outline" href="/pppoe/import">Import Accounts</a>
    </div>
    <form class="filters pppoe-filters" id="filters" method="get" action="/pppoe">
        @if (Model.SortBy is not null)
        {
            <input type="hidden" name="sortBy" value="@Model.SortBy">
            <input type="hidden" name="sortDir" value="@(Model.Descending ? "desc" : "asc")">
        }
        <div class="field">
            <label for="search">&nbsp;</label>
            <div class="search-wrap">
                <svg class="icon"><use href="#icon-search" /></svg>
                <input id="search" name="search" type="search" value="@Model.Search" maxlength="100" placeholder="Search by username, customer, or plan..." autocomplete="off">
            </div>
        </div>
        <div class="field">
            <label for="state">Account</label>
            <select id="state" name="state">
                @foreach (var (value, label) in new[]
                {
                    ("all", $"All ({data.Stats.Total})"), ("enabled", $"Enabled ({data.Stats.Enabled})"),
                    ("disabled", $"Disabled ({data.Stats.Disabled})"), ("notcreated", $"Not created ({data.Stats.NotCreated})"),
                    ("terminated", "Terminated"), ("requested", $"Waiting for approval ({data.Stats.PendingRequests})"),
                })
                {
                    <option value="@value" selected="@(value == Model.State)">@label</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary"><svg class="icon"><use href="#icon-search" /></svg>Search</button>
        <a href="/pppoe" class="btn"><svg class="icon"><use href="#refresh" /></svg>Reset</a>
    </form>
    <div class="table-scroll">
        <table class="customers-table all-table">
            <thead>
                <tr>
                    @foreach (var (column, label) in new[] { ("username", "Username"), ("customer", "Customer"), ("plan", "Profile"), ("state", "Secret"), ("requested", "Session") })
                    {
                        <th aria-sort="@Model.AriaSort(column)"><a class="th-sort" href="@Model.SortUrl(column)">@label<span class="sort-mark" aria-hidden="true">@(Model.SortBy == column ? (Model.Descending ? "▼" : "▲") : "")</span></a></th>
                    }
                    <th>Router</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (data.Items.Count == 0)
                {
                    <tr><td colspan="7" style="text-align:center;padding:28px">No matching PPPoE accounts found.</td></tr>
                }
                @foreach (var a in data.Items)
                {
                    <tr>
                        <td class="name">@a.PppoeUsername</td>
                        <td><a class="customer-link" href="/customers/@a.CustomerId">@a.CustomerName</a></td>
                        <td>@a.PlanName</td>
                        <td><span class="pill @PppoeLabels.StatePill(a.AccountState)">@PppoeLabels.State(a.AccountState)</span></td>
                        <td>
                            @if (a.PendingOperation is not null)
                            {
                                <span class="pill pending">@PppoeLabels.Operation(a.PendingOperation) requested</span>
                            }
                            else
                            {
                                <span title="Live session data needs the router connection">Not checked</span>
                            }
                        </td>
                        <td><span class="pill unknown" title="Changes are sent to MikroTik once the router connection exists">@PppoeLabels.Router(a.RouterSyncStatus)</span></td>
                        <td>
                            <a class="btn btn-primary" href="/pppoe/@a.CustomerId">View</a>
                            @if (a.CanDelete)
                            {
                                <a class="btn btn-outline" href="/pppoe/@a.CustomerId/delete" aria-label="Delete @a.PppoeUsername">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @{
        var first = data.TotalMatching == 0 ? 0 : (data.Page - 1) * data.PageSize + 1;
        var last = Math.Min(data.Page * data.PageSize, data.TotalMatching);
    }
    <div class="pagination-bar">
        <div>Showing @first to @last of @data.TotalMatching accounts</div>
        <div class="pager" aria-label="Pagination">
            <button type="submit" form="filters" name="page" value="1" disabled="@(data.Page <= 1)" aria-label="First page">«</button>
            <button type="submit" form="filters" name="page" value="@(data.Page - 1)" disabled="@(data.Page <= 1)" aria-label="Previous page">‹</button>
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <button type="submit" form="filters" name="page" value="@p" class="@(p == data.Page ? "active" : null)" aria-label="Page @p" aria-current="@(p == data.Page ? "page" : null)">@p</button>
            }
            <button type="submit" form="filters" name="page" value="@(data.Page + 1)" disabled="@(data.Page >= Model.TotalPages)" aria-label="Next page">›</button>
            <button type="submit" form="filters" name="page" value="@Model.TotalPages" disabled="@(data.Page >= Model.TotalPages)" aria-label="Last page">»</button>
        </div>
        <div class="rows-select">
            <label for="pageSize">Rows per page:</label>
            <select id="pageSize" name="pageSize" form="filters" data-autosubmit>
                @foreach (var size in PppoeListQuery.AllowedPageSizes)
                {
                    <option selected="@(size == Model.PageSize)">@size</option>
                }
            </select>
        </div>
    </div>
</section>
<section class="panel module-panel">
    <div class="module-head"><h2>Provisioning Rules</h2></div>
    <p>An Active account must be disabled before its PPPoE details can change. Disabling and re-enabling need a Manager's approval; a Manager's own request is approved at once. Approved changes are saved here and marked <strong>Not sent</strong> until the MikroTik router connection is set up. Termination disables the PPPoE secret without deleting customer history.</p>
</section>
