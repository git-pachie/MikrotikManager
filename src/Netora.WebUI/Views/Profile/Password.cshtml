@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    var formError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<div class="heading">
    <div class="heading-title">
        <svg class="icon"><use href="#settings" /></svg>
        <div>
            <h1>Change Password</h1>
            <p>@(Model.Forced ? "Your account has a temporary password. Choose your own password to continue." : "Choose a new password for your account.")</p>
        </div>
    </div>
    @if (!Model.Forced)
    {
        <div class="heading-actions"><a class="btn btn-outline" href="/profile">My Profile</a></div>
    }
</div>
@if (Model.Forced)
{
    <div class="detail-alert" role="status">Other pages are available after you change your password.</div>
}
@if (formError is not null)
{
    <div class="form-alert" role="alert">@formError</div>
}

<form method="post" action="/profile/password" novalidate>
    @Html.AntiForgeryToken()
    <section class="panel module-panel">
        <div class="module-fields">
            <label class="span-2">@(Model.Forced ? "Temporary password" : "Current password") *<input asp-for="CurrentPassword" type="password" autocomplete="current-password" required value=""><span asp-validation-for="CurrentPassword" class="field-error"></span></label>
            <label>New password *<input asp-for="NewPassword" type="password" autocomplete="new-password" maxlength="128" required value=""><span asp-validation-for="NewPassword" class="field-error"></span></label>
            <label>Confirm new password *<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" maxlength="128" required value=""><span asp-validation-for="ConfirmPassword" class="field-error"></span></label>
        </div>
        <div class="module-actions">
            <button class="btn btn-primary" type="submit">Change Password</button>
        </div>
        <p class="module-note">At least 10 characters, with an uppercase letter, a lowercase letter, a digit and a symbol. Five wrong current passwords lock the account for 15 minutes.</p>
    </section>
</form>
