@model CustomerDetailViewModel
@using Netora.Application.Customers.Attachments
@{
    ViewData["Title"] = "Customer Details";
    ViewData["Nav"] = "customers";
    var d = Model.Data;
    var rs = Model.Router;
    var secretText = d?.PppoeDeleted == true && rs?.SecretFound != true ? "Deleted"
        : rs is null ? "Not checked" : !rs.Reachable ? "Router not reachable" : rs.SecretFound ? rs.SecretState! : rs.SecretExpected ? "Missing on router" : "Not created yet";
    var liveText = rs is null ? "Not checked" : !rs.Reachable ? "Unknown" : rs.SessionActive ? "Online" : "Offline";
}
<div class="detail-breadcrumb"><a href="/customers">Customers</a><span> / </span><strong>Customer Details</strong></div>
<div class="heading">
    <div class="heading-title">
        <svg class="icon"><use href="#users" /></svg>
        <div>
            <h1>Customer Details</h1>
            <p>Subscriber profile, service configuration, ONU records, and connection diagnostics.</p>
        </div>
    </div>
    @if (d is not null)
    {
        <div class="heading-actions">
            @if (d.IsEditable)
            {
                <a class="btn btn-outline" href="/customers/@d.Id/edit"><svg class="icon"><use href="#edit" /></svg>Edit Customer</a>
            }
            else
            {
                <button type="button" class="btn btn-outline" disabled title="Terminated customers are view-only for Staff"><svg class="icon"><use href="#edit" /></svg>Edit Customer</button>
            }
            @if (d.Status == "Active" && d.IsEditable)
            {
                <a class="btn btn-primary" href="/pppoe/@d.Id">Request Plan Change</a>
            }
            else
            {
                <button type="button" class="btn btn-primary" disabled title="Plan change requests are for Active accounts">Request Plan Change</button>
            }
            @if (d.CanDeletePppoe)
            {
                <a class="btn btn-danger-outline" href="/pppoe/@d.Id/delete?from=customer">Delete PPPoE Account</a>
            }
            @if (User.IsInRole("Manager"))
            {
                <a class="btn btn-danger-outline" href="/customers/@d.Id/delete">Delete Customer</a>
            }
        </div>
    }
</div>
@if (TempData[Netora.WebUI.Controllers.CustomersController.ToastKey] is string toast)
{
    <div class="form-success" role="status">@toast</div>
}
@if (TempData[Netora.WebUI.Controllers.CustomersController.ErrorKey] is string toastError)
{
    <div class="form-alert" role="alert">@toastError</div>
}
@if (d is null)
{
    <section class="panel" role="alert"><p class="mb-0" style="color:var(--muted)">@Model.ErrorMessage</p></section>
    return;
}
<section class="detail-hero panel">
    <div class="detail-identity">
        <div class="detail-avatar" aria-hidden="true">@Model.Initials</div>
        <div>
            <h2>@Model.FullName</h2>
            <div class="detail-secondary">Customer ID: @d.DisplayId <span class="detail-dot">•</span> Registered @CustomerDetailViewModel.Date(d.CreatedAtUtc)</div>
            <div class="detail-tags">
                <span class="pill @Model.StatusPillClass">
                    @if (d.Status == "Active") { <svg class="icon"><use href="#wifi" /></svg> }
                    else if (d.Status == "Terminated") { <svg class="icon"><use href="#x" /></svg> }
                    else if (d.Status == "PendingApproval") { <svg class="icon"><use href="#clipboard" /></svg> }
                    else { <text>Ⅱ</text> }
                    @Model.StatusLabel
                </span>
                <span class="pill @(d.NapBox == "UNKNOWN" ? "unknown" : "nap")">@d.NapBox</span>
                <span class="pill detail-soft">@d.PlanName</span>
                @if (d.IsManagerOnly) { <span class="pill detail-soft">Managers only</span> }
            </div>
        </div>
    </div>
    <div class="detail-live">
        <span class="detail-live-label">PPPoE Connection</span>
        <div class="detail-live-value">@if (rs is { SessionActive: true }) { <span class="online-dot"></span> }@liveText</div>
        <span class="detail-secondary">@(rs is null ? "Router status could not be checked" : rs.Reachable ? $"{(rs.AssignedIp is null ? "No session" : rs.AssignedIp)} • checked {CustomerDetailViewModel.DateTime(rs.CheckedAtUtc)}{(rs.Mode == "Mock" ? " • Mock router" : "")}" : "Router not reachable")</span>
    </div>
</section>
@if (d.Status == "PendingApproval")
{
    <div class="detail-alert">This customer is waiting for Manager approval. No PPPoE account exists on the router yet. The request is listed under <a href="/approvals">Pending Approvals</a> and on the <a href="/pppoe/@d.Id">PPPoE account</a> page.</div>
}
<div class="detail-kpis">
    <div class="panel detail-kpi"><span>PPPoE Username</span><strong>@d.PppoeUsername</strong><small>Router secret: @secretText</small></div>
    <div class="panel detail-kpi"><span>Internet Plan</span><strong>@d.PlanName</strong><small>@(rs is { Reachable: true, SecretFound: true } ? $"Router profile: {rs.ActualProfile ?? "not set"}" : "Used as the PPP profile on the router")</small></div>
    <div class="panel detail-kpi"><span>NAP Assignment</span><strong>@d.NapBox</strong><small>@(d.NapBox == "UNKNOWN" ? "Not mapped to a NAP box" : "Assigned subscriber")</small></div>
    <div class="panel detail-kpi"><span>ONU Serial</span><strong>@CustomerDetailViewModel.OrDash(d.OnuSerial)</strong><small>@(string.IsNullOrWhiteSpace(d.OnuSerial) ? "No device recorded" : "Current device record")</small></div>
</div>
<section class="panel detail-panel">
    <div class="detail-tabs" role="tablist" aria-label="Customer sections">
        <button type="button" class="detail-tab active" id="tab-overview" data-tab="overview" role="tab" aria-selected="true" aria-controls="pane-overview">Overview</button>
        <button type="button" class="detail-tab" id="tab-pppoe" data-tab="pppoe" role="tab" aria-selected="false" aria-controls="pane-pppoe" tabindex="-1">PPPoE &amp; Diagnostics</button>
        <button type="button" class="detail-tab" id="tab-onu" data-tab="onu" role="tab" aria-selected="false" aria-controls="pane-onu" tabindex="-1">ONU History</button>
        <button type="button" class="detail-tab" id="tab-attachments" data-tab="attachments" role="tab" aria-selected="false" aria-controls="pane-attachments" tabindex="-1">Attachments</button>
        <button type="button" class="detail-tab" id="tab-activity" data-tab="activity" role="tab" aria-selected="false" aria-controls="pane-activity" tabindex="-1">Activity &amp; Audit</button>
    </div>

    <div class="detail-tab-pane" id="pane-overview" data-pane="overview" role="tabpanel" aria-labelledby="tab-overview">
        <div class="detail-columns">
            <section class="detail-section">
                <div class="section-head">
                    <h3>Personal Information</h3>
                    @if (d.IsEditable) { <a class="text-action" href="/customers/@d.Id/edit">Edit</a> }
                </div>
                <div class="detail-fields">
                    <div><span>Full Name</span><strong>@Model.FullName</strong></div>
                    <div><span>Mobile Number</span><strong>@CustomerDetailViewModel.OrDash(d.MobileNumber)</strong></div>
                    <div><span>Email Address</span><strong>@CustomerDetailViewModel.OrDash(d.Email)</strong></div>
                    <div><span>Customer Status</span><strong>@Model.StatusLabel</strong></div>
                    <div class="wide"><span>Installation Address</span><strong>@CustomerDetailViewModel.OrDash(d.Address)</strong></div>
                </div>
            </section>
            <section class="detail-section">
                <div class="section-head">
                    <h3>Subscription &amp; Network</h3>
                    @if (d.IsEditable) { <a class="text-action" href="/customers/@d.Id/edit">Edit</a> }
                </div>
                <div class="detail-fields">
                    <div><span>Internet Plan</span><strong>@d.PlanName</strong></div>
                    <div><span>PPPoE Username</span><strong>@d.PppoeUsername</strong></div>
                    <div><span>NAP Box</span><strong>@d.NapBox</strong></div>
                    <div><span>ONU Record</span><strong>@(string.IsNullOrWhiteSpace(d.OnuSerial) ? "Not recorded" : "Recorded")</strong></div>
                    <div><span>PPPoE Secret</span><strong>@secretText</strong></div>
                    <div><span>Last Updated</span><strong>@(d.UpdatedAtUtc is { } u ? CustomerDetailViewModel.DateTime(u) : "Never edited")</strong></div>
                </div>
            </section>
        </div>
        <div class="detail-bottom">
            <div>
                <h3>Internal Notes</h3>
                <p>@(string.IsNullOrWhiteSpace(d.Notes) ? "No notes recorded." : d.Notes)</p>
            </div>
            @if (d.IsEditable) { <a class="btn" href="/customers/@d.Id/edit">Edit Notes</a> }
        </div>
    </div>

    <div class="detail-tab-pane" id="pane-pppoe" data-pane="pppoe" role="tabpanel" aria-labelledby="tab-pppoe" hidden>
        <div class="section-head">
            <h3>PPPoE Connection &amp; Diagnostics</h3>
            <div class="heading-actions">
                @if (!d.PppoeDeleted)
                {
                    <a class="btn btn-outline" href="/pppoe/@d.Id"><svg class="icon"><use href="#wifi" /></svg>PPPoE Account</a>
                }
                <a class="btn btn-outline" href="/customers/@d.Id" data-refresh-pppoe title="Checks the router again"><svg class="icon"><use href="#refresh" /></svg>Refresh Status</a>
            </div>
        </div>
        @if (rs is null)
        {
            <div class="detail-alert">The router status could not be checked because the Web API did not answer. This is not a confirmed offline state.</div>
        }
        else if (!rs.Reachable)
        {
            <div class="form-alert" role="alert">Router not reachable: @rs.Error This is not a confirmed offline state.</div>
        }
        else
        {
            <div class="detail-alert">Checked @CustomerDetailViewModel.DateTime(rs.CheckedAtUtc) on the @(rs.Mode == "Mock" ? "mock router (no real MikroTik; values are fictional)" : "MikroTik router"). Checked only when this page is opened or refreshed.</div>
        }
        <div class="detail-fields detail-diagnostics">
            <div><span>PPPoE Username</span><strong>@d.PppoeUsername</strong></div>
            <div><span>Secret Status</span><strong>@secretText</strong></div>
            <div><span>Session Status</span><strong>@(rs is { Reachable: true, SecretFound: true } ? (rs.SessionActive ? $"Online{(rs.Uptime is null ? "" : $", up {rs.Uptime}")}" : "Offline") : "Unavailable")</strong></div>
            <div><span>Assigned IP (active session)</span><strong>@(rs?.AssignedIp ?? "—")</strong></div>
            <div><span>Local IP</span><strong>@Model.LocalIp</strong></div>
            <div><span>Remote IP</span><strong>@Model.RemoteIp</strong></div>
            <div>
                <span>PPPoE Password</span>
                <partial name="_PppoePassword" model="@(new PppoePasswordViewModel(d.Id, d.PppoePasswordSet))" />
            </div>
            <div><span>Profile (expected)</span><strong>@d.PlanName</strong></div>
            <div><span>Profile (router)</span><strong>@(rs?.ActualProfile ?? "—")</strong></div>
            <div><span>Configuration Mismatch</span><strong>@(rs is not { Reachable: true } ? "Not checked" : rs.Mismatches.Count == 0 ? "None" : $"{rs.Mismatches.Count} difference(s)")</strong></div>
        </div>
        @if (rs is { Reachable: true, Mismatches.Count: > 0 })
        {
            <h3 class="detail-subtitle">Configuration Mismatch</h3>
            <div class="table-scroll">
                <table class="customers-table detail-table">
                    <thead><tr><th>Setting</th><th>Netora (SQL Server)</th><th>Router</th></tr></thead>
                    <tbody>
                        @foreach (var m in rs.Mismatches)
                        {
                            <tr><td>@m.Field</td><td>@m.Expected</td><td>@m.Actual</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="module-note">Nothing is changed automatically on either side. Correct the record in Netora, or the router, or send the account again through an approved request.</p>
        }
        <section class="pppoe-traffic" aria-labelledby="traffic-title" data-traffic-url="@Url.Action("PppoeTraffic", "Customers", new { id = d.Id })">
            <div class="pppoe-traffic-heading">
                <h3 id="traffic-title">Live PPPoE Traffic</h3>
                <p>Last 5 minutes</p>
            </div>
            <dl class="pppoe-traffic-rates">
                <div class="traffic-download">
                    <dt><svg class="icon" aria-hidden="true"><use href="#download" /></svg>Download</dt>
                    <dd data-download>—</dd>
                </div>
                <div class="traffic-upload">
                    <dt><svg class="icon" aria-hidden="true"><use href="#upload" /></svg>Upload</dt>
                    <dd data-upload>—</dd>
                </div>
            </dl>
            <canvas role="img" aria-label="Line chart of download and upload traffic over the last 5 minutes, in Mbps" aria-describedby="traffic-status"></canvas>
            <p id="traffic-status" role="status">Waiting for traffic data.</p>
        </section>
        <h3 class="detail-subtitle">Recent PPPoE Logs</h3>
        <a class="btn btn-outline" href="/diagnostics?customerId=@d.Id">Open Diagnostics</a>
    </div>

    <div class="detail-tab-pane" id="pane-onu" data-pane="onu" role="tabpanel" aria-labelledby="tab-onu" hidden>
        <div class="section-head">
            <h3>ONU Information &amp; Replacement History</h3>
            @if (d.IsEditable)
            {
                <a class="btn btn-outline" href="/onu-history/@d.Id/replace">Record Replacement</a>
            }
        </div>
        <div class="detail-fields detail-diagnostics">
            <div><span>Serial Number</span><strong>@(string.IsNullOrWhiteSpace(d.OnuSerial) ? "Not recorded" : d.OnuSerial)</strong></div>
            <div><span>Brand / Model</span><strong>@(string.IsNullOrWhiteSpace(d.OnuModel) ? "Not recorded" : d.OnuModel)</strong></div>
        </div>
        <h3 class="detail-subtitle">Replacement History</h3>
        <a class="btn btn-outline" href="/onu-history?customerId=@d.Id">View Replacement History</a>
    </div>

    <div class="detail-tab-pane" id="pane-attachments" data-pane="attachments" role="tabpanel" aria-labelledby="tab-attachments" hidden>
        <div class="section-head">
            <h3>Customer Attachments</h3>
            @if (d.IsEditable)
            {
                <form class="attach-form" id="attachmentForm" asp-controller="Customers" asp-action="UploadAttachment" asp-route-id="@d.Id" method="post" enctype="multipart/form-data">
                    @* The native picker is hidden; the button opens it and choosing a file uploads straight away (details.js). *@
                    <input id="attachmentFile" class="attach-input" name="file" type="file" required tabindex="-1" aria-hidden="true" accept="@AttachmentFileTypes.AcceptList" data-max-bytes="@d.MaxAttachmentBytes" data-max-label="@AttachmentFileTypes.FormatSize(d.MaxAttachmentBytes)">
                    <button type="button" class="btn btn-outline" id="attachmentPick" aria-describedby="attachmentRules"><svg class="icon"><use href="#upload" /></svg><span>Upload File</span></button>
                </form>
            }
        </div>
        <p class="module-note" id="attachmentRules">@AttachmentFileTypes.Labels only, up to @AttachmentFileTypes.FormatSize(d.MaxAttachmentBytes) per file.@(d.IsEditable ? "" : " This customer is terminated: Staff can view and download files only.")</p>
        @if (d.Attachments.Count == 0)
        {
            <div class="detail-empty">No files uploaded.</div>
        }
        else
        {
            <div class="table-scroll">
                <table class="customers-table detail-table">
                    <thead><tr><th>File</th><th>Type</th><th>Size</th><th>Uploaded By</th><th>Uploaded</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var f in d.Attachments)
                        {
                            <tr>
                                <td class="name">
                                    @if (f.FileType is "PNG" or "JPG")
                                    {
                                        <a class="customer-link" href="/customers/@d.Id/attachments/@f.Id" data-gallery data-name="@f.FileName" title="View image">@f.FileName</a>
                                    }
                                    else
                                    {
                                        <a class="customer-link" href="/customers/@d.Id/attachments/@f.Id" title="Download">@f.FileName</a>
                                    }
                                </td>
                                <td>@f.FileType</td>
                                <td>@AttachmentFileTypes.FormatSize(f.SizeBytes)</td>
                                <td>@f.UploadedBy</td>
                                <td>@CustomerDetailViewModel.DateTime(f.UploadedAtUtc)</td>
                                <td>
                                    <div class="actions">
                                        <a class="action-btn" href="/customers/@d.Id/attachments/@f.Id" title="Download" aria-label="Download @f.FileName"><svg class="icon"><use href="#file" /></svg></a>
                                        @if (d.IsEditable)
                                        {
                                            <form asp-controller="Customers" asp-action="DeleteAttachment" asp-route-id="@d.Id" asp-route-attachmentId="@f.Id" method="post" data-confirm="Delete @f.FileName? It will no longer be listed.">
                                                <button type="submit" class="action-btn" title="Delete" aria-label="Delete @f.FileName"><svg class="icon"><use href="#x" /></svg></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="detail-tab-pane" id="pane-activity" data-pane="activity" role="tabpanel" aria-labelledby="tab-activity" hidden>
        <div class="section-head"><h3>Activity &amp; Audit Trail</h3></div>
        @if (d.Activity.Count == 0)
        {
            <div class="detail-empty">No activity recorded for this customer yet. Customers created before activity tracking have no earlier history.</div>
        }
        else
        {
            <div class="table-scroll">
                <table class="customers-table detail-table">
                    <thead><tr><th>Date</th><th>Action</th><th>Details</th><th>Performed By</th><th>Result</th></tr></thead>
                    <tbody>
                        @foreach (var a in d.Activity)
                        {
                            <tr>
                                <td>@CustomerDetailViewModel.DateTime(a.OccurredAtUtc)</td>
                                <td>@CustomerDetailViewModel.ActionLabel(a.Action)</td>
                                <td>@CustomerDetailViewModel.OrDash(a.Detail)</td>
                                <td>@a.PerformedBy</td>
                                <td>@a.Outcome</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
@if (d.Attachments.Any(a => a.FileType is "PNG" or "JPG"))
{
    <dialog class="image-viewer" id="imageViewer" aria-labelledby="imageViewerTitle">
        <div class="viewer-head">
            <div>
                <h3 id="imageViewerTitle">Image</h3>
                <span class="viewer-count" id="imageViewerCount" aria-live="polite"></span>
            </div>
            <div class="viewer-tools">
                <a class="btn btn-outline" id="imageViewerDownload" href="#"><svg class="icon"><use href="#file" /></svg>Download</a>
                <button type="button" class="action-btn" id="imageViewerClose" aria-label="Close"><svg class="icon"><use href="#x" /></svg></button>
            </div>
        </div>
        <div class="viewer-stage">
            <button type="button" class="viewer-nav prev" id="imageViewerPrev" aria-label="Previous image"><svg class="icon"><use href="#chevron" /></svg></button>
            <img id="imageViewerImg" alt="">
            <p class="viewer-error" id="imageViewerError" hidden>The image could not be loaded.</p>
            <button type="button" class="viewer-nav next" id="imageViewerNext" aria-label="Next image"><svg class="icon"><use href="#chevron" /></svg></button>
        </div>
        <div class="viewer-thumbs" id="imageViewerThumbs" role="list" aria-label="All images"></div>
    </dialog>
}
@section Scripts {
    <script src="~/js/details.js" asp-append-version="true"></script>
    <script src="~/js/pppoe-traffic.js" asp-append-version="true"></script>
    <script src="~/js/attachments.js" asp-append-version="true"></script>
    <script src="~/js/pppoe-password.js" asp-append-version="true"></script>
}
