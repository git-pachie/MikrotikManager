@model SettingsViewModel
@{
    ViewData["Title"] = "Settings";
    ViewData["Nav"] = "settings";
    var d = Model.Data;
    var formError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<div class="heading">
    <div class="heading-title">
        <svg class="icon"><use href="#users" /></svg>
        <div>
            <h1>Settings</h1>
            <p>Configure application, router, notifications, and operational defaults.</p>
        </div>
    </div>
    <div class="heading-actions"><a class="btn btn-outline" href="/customers">Customers</a></div>
</div>
@if (TempData[Netora.WebUI.Controllers.CustomersController.ToastKey] is string toast)
{
    <div class="form-success" role="status">@toast</div>
}
@if (TempData[Netora.WebUI.Controllers.CustomersController.ErrorKey] is string error)
{
    <div class="form-alert" role="alert">@error</div>
}
@if (formError is not null)
{
    <div class="form-alert" role="alert">@formError</div>
}
@if (d is null)
{
    <section class="panel" role="alert"><p class="mb-0" style="color:var(--muted)">@Model.ErrorMessage</p></section>
    return;
}

<section class="panel module-panel">
    <div class="module-head">
        <h2>MikroTik Connection</h2>
        <span class="pill @(d.Router.Mode == "Mock" ? "pending" : "nap")">@(d.Router.Mode == "Mock" ? "Mock router" : "RouterOS")</span>
    </div>
    <form method="post" action="/settings/router" novalidate>
        @Html.AntiForgeryToken()
        <div class="module-fields">
            <label>Router Name<input asp-for="Router.Name" maxlength="100" placeholder="Primary MikroTik"><span asp-validation-for="Router.Name" class="field-error"></span></label>
            <label>Router Address<input asp-for="Router.Address" maxlength="253" placeholder="192.168.88.1 or router.example"><span asp-validation-for="Router.Address" class="field-error"></span></label>
            <label>Router Mode
                <select asp-for="Router.Mode" aria-describedby="router-mode-note">
                    <option value="Mock">Mock router</option>
                    <option value="RouterOS">RouterOS (live MikroTik over HTTPS)</option>
                </select>
                <span asp-validation-for="Router.Mode" class="field-error"></span>
            </label>
            <label>Connection Status<input value="@(d.Router.ConnectionStatus switch { "Connected" when d.Router.Mode == "Mock" => "Mock test passed", "Connected" => "Connected to MikroTik", "Failed" => "Failed", _ => "Not tested" })@(d.Router.LastTestedAtUtc is { } lt ? $" ({UserLabels.When(lt)})" : "")" readonly></label>
            <label>HTTPS Port<input asp-for="Router.Port" type="number" min="1" max="65535"><span asp-validation-for="Router.Port" class="field-error"></span></label>
            <label>API User Name<input asp-for="Router.UserName" maxlength="100" autocomplete="off" placeholder="netora-api"><span asp-validation-for="Router.UserName" class="field-error"></span></label>
            <label>API Password
                <input asp-for="Router.NewPassword" type="password" maxlength="128" autocomplete="new-password" value=""
                       placeholder="@(d.Router.PasswordUnreadable ? "Re-enter the API password" : d.Router.PasswordSet ? "Saved. Leave blank to keep it" : "Not set")">
                <span asp-validation-for="Router.NewPassword" class="field-error"></span>
            </label>
            <label class="span-2">HTTPS Certificate Fingerprint (SHA-256, optional)<input asp-for="Router.CertificateThumbprint" maxlength="120" autocomplete="off" placeholder="Only for a self-signed router certificate: 64 hex characters"><span asp-validation-for="Router.CertificateThumbprint" class="field-error"></span></label>
        </div>
        <div class="module-actions">
            <button type="submit" class="btn btn-primary">Save Router Settings</button>
            <button type="submit" class="btn btn-outline" form="test-router" title="Uses the saved settings. Save first if you changed anything.">Test Connection</button>
            @if (d.Router.PasswordSet)
            {
                <label class="module-check"><input asp-for="Router.ClearPassword" type="checkbox"> Remove the saved password</label>
            }
        </div>
    </form>
    <form id="test-router" method="post" action="/settings/router/test">@Html.AntiForgeryToken()</form>
    @if (d.Router.PasswordUnreadable)
    {
        <p class="form-alert" role="alert">The saved MikroTik password cannot be read on this server. Re-enter the API password and save Router Settings.</p>
    }
    @if (d.Router.LastTestMessage is not null)
    {
        <p class="module-note">Last test: @d.Router.LastTestMessage</p>
    }
    <p class="module-note" id="router-mode-note">The saved mode applies to all Netora router actions. Select RouterOS to use your MikroTik, then save and test the connection.</p>
    <p class="module-note">Netora encrypts the API password. Use a dedicated RouterOS user and limit HTTPS REST access (www-ssl) to this server.</p>
</section>

<section class="panel module-panel" id="notifications">
    <div class="module-head">
        <h2>Email Configuration</h2>
        <span class="pill @(d.Email.NotReadyReason is null ? "active" : "unknown")">@(d.Email.NotReadyReason switch { null => "Emails on", "Disabled" => "Emails off", _ => "Not configured" })</span>
    </div>
    @if (Model.TestResult is { } test)
    {
        <div class="@(test.Sent ? "form-success" : "form-alert")" role="status">Test email: @test.Message</div>
    }
    <form method="post" action="/settings/email" novalidate>
        @Html.AntiForgeryToken()
        <div class="module-fields">
            <label>SMTP Server<input asp-for="Email.Smtp.Host" maxlength="253" placeholder="smtp.example.com"><span asp-validation-for="Email.Smtp.Host" class="field-error"></span></label>
            <label>SMTP Port<input asp-for="Email.Smtp.Port" type="number" min="1" max="65535"><span asp-validation-for="Email.Smtp.Port" class="field-error"></span></label>
            <label>SMTP Login (email or username)<input asp-for="Email.Smtp.UserName" maxlength="256" autocomplete="off" placeholder="mailer@example.com"><span asp-validation-for="Email.Smtp.UserName" class="field-error"></span></label>
            <label>SMTP Password<input asp-for="Email.Smtp.NewPassword" type="password" maxlength="256" autocomplete="new-password" value=""
                placeholder="@(d.Email.SmtpPasswordSet ? "Saved. Leave blank to keep it." : "Password or app password")"><span asp-validation-for="Email.Smtp.NewPassword" class="field-error"></span></label>
            <label>Connection Security
                <select asp-for="Email.Smtp.Security">
                    <option value="StartTls">STARTTLS</option>
                    <option value="TlsOnConnect">TLS on connect (SSL/TLS)</option>
                    <option value="None">None (unauthenticated relay)</option>
                </select>
                <span asp-validation-for="Email.Smtp.Security" class="field-error"></span>
            </label>
            <label>Timeout (seconds)<input asp-for="Email.Smtp.TimeoutSeconds" type="number" min="5" max="120"><span asp-validation-for="Email.Smtp.TimeoutSeconds" class="field-error"></span></label>
            <label>From Address<input asp-for="Email.From" type="email" maxlength="256" placeholder="noreply@example.com"><span asp-validation-for="Email.From" class="field-error"></span></label>
            <label>Sender Name<input asp-for="Email.FromName" maxlength="100" placeholder="Netora"><span asp-validation-for="Email.FromName" class="field-error"></span></label>
            <label>Link Address (optional)<input asp-for="Email.AppBaseUrl" maxlength="300" placeholder="https://netora.example/"><span asp-validation-for="Email.AppBaseUrl" class="field-error"></span></label>
            <label>Manager Recipients<input value="@d.Email.ManagerRecipients active Manager(s) with an email address" readonly></label>
        </div>
        <div class="module-actions">
            <label class="module-check"><input asp-for="Email.Enabled" type="checkbox"> Send approval emails</label>
            <label class="module-check"><input asp-for="Email.Smtp.CheckCertificateRevocation" type="checkbox"> Check certificate revocation</label>
            @if (d.Email.SmtpPasswordSet)
            {
                <label class="module-check"><input asp-for="Email.Smtp.ClearPassword" type="checkbox"> Remove saved SMTP password</label>
            }
        </div>
        <div class="module-actions">
            <button type="submit" class="btn btn-primary">Save Email Settings</button>
        </div>
    </form>
    <form method="post" action="/settings/email/test" class="module-actions">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline">Send Test Email to Me</button>
        <span class="module-note">Uses the saved settings to send to the address in My Profile, even while approval emails are off.</span>
    </form>
    <p class="module-note">Netora encrypts the SMTP password and shows only whether it is saved.</p>
</section>

<section class="panel module-panel">
    <div class="module-head"><h2>Initial Configuration</h2></div>
    <div class="table-scroll">
        <table class="customers-table all-table">
            <thead><tr><th>Item</th><th>Status</th><th>Detail</th></tr></thead>
            <tbody>
                @foreach (var s in d.Setup)
                {
                    <tr>
                        <td>@s.Item</td>
                        <td><span class="pill @(s.Done ? "active" : "disabled")">@(s.Done ? "Done" : "To do")</span></td>
                        <td>@s.Detail</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="panel module-panel">
    <div class="module-head"><h2>Theme &amp; Security</h2></div>
    <p>Each user's light or dark theme is saved to their account when they use the switch in the top bar, and follows them to other browsers. Production configuration includes secure cookies, ASP.NET Core Identity, server-side role checks, and encrypted credential storage.</p>
    <p class="module-note">Your own name, email address, theme and password are in <a href="/profile">My Profile</a>.</p>
</section>
