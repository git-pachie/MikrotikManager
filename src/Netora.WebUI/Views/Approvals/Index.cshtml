@model ApprovalListViewModel
@{
    ViewData["Title"] = "Pending Approvals";
    ViewData["Nav"] = "approvals";
    var data = Model.Data;
    var pendingView = Model.Status == "pending";
}
<div class="heading">
    <div class="heading-title">
        <svg class="icon"><use href="#users" /></svg>
        <div>
            <h1>Pending Approvals</h1>
            <p>Review customer PPPoE operations and authorise provisioning.</p>
        </div>
    </div>
    <div class="heading-actions"><a class="btn btn-outline" href="/customers">Customers</a></div>
</div>
@if (TempData[Netora.WebUI.Controllers.CustomersController.ToastKey] is string toast)
{
    <div class="form-success" role="status">@toast</div>
}
@if (TempData[Netora.WebUI.Controllers.CustomersController.ErrorKey] is string error)
{
    <div class="form-alert" role="alert">@error</div>
}
@if (data is null)
{
    <section class="panel" role="alert"><p class="mb-0" style="color:var(--muted)">@Model.ErrorMessage</p></section>
    return;
}

<section class="panel module-panel">
    <div class="module-head approval-head">
        <h2>@(pendingView ? "Requests Awaiting Review" : "Approval Requests")</h2>
        <form class="approval-filter" method="get" action="/approvals" role="search">
            <div class="field">
                <label for="status">Request status</label>
                <select id="status" name="status" data-autosubmit>
                    @foreach (var (value, label) in ApprovalLabels.StatusFilters)
                    {
                        var count = value switch { "pending" => data.Counts.Pending, "approved" => data.Counts.Approved, "rejected" => data.Counts.Rejected, _ => data.Counts.Pending + data.Counts.Approved + data.Counts.Rejected };
                        <option value="@value" selected="@(value == Model.Status)">@label (@count)</option>
                    }
                </select>
            </div>
            <div class="field search-field">
                <label for="search">Search requests</label>
                <input id="search" type="search" name="search" value="@Model.Search" maxlength="100" placeholder="Customer or requester">
            </div>
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
    </div>
    <div class="table-scroll">
        <table class="customers-table all-table">
            <thead><tr><th>Request ID</th><th>Requested By</th><th>Customer</th><th>Operation</th><th>Submitted</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @if (data.Items.Count == 0)
                {
                    <tr><td colspan="7" style="text-align:center;padding:28px">@(pendingView && Model.Search is null ? "No requests are waiting for review." : "No matching requests found.")</td></tr>
                }
                @foreach (var r in data.Items)
                {
                    <tr>
                        <td>@r.DisplayId</td>
                        <td>@r.RequestedBy</td>
                        <td><a class="customer-link" href="/customers/@r.CustomerId">@r.CustomerName</a></td>
                        <td>@ApprovalLabels.Operation(r.Operation)</td>
                        <td>@ApprovalLabels.Date(r.RequestedAtUtc)</td>
                        <td><span class="pill @ApprovalLabels.StatusPill(r.Status)">@r.Status</span></td>
                        <td>
                            <a class="btn @(r.Status == "Pending" && Model.IsManager ? "btn-primary" : "btn-outline")" href="/approvals/@r.Id">@(r.Status == "Pending" && Model.IsManager ? "Review" : "View")</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        var first = (data.Page - 1) * data.PageSize + 1;
        var last = Math.Min(data.Page * data.PageSize, data.TotalMatching);
        <div class="pagination-bar">
            <div>Showing @first to @last of @data.TotalMatching requests</div>
            <nav class="pager" aria-label="Pagination">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <a class="pager-link @(p == data.Page ? "active" : null)" href="@Model.PageUrl(p)" aria-current="@(p == data.Page ? "page" : null)">@p</a>
                }
            </nav>
        </div>
    }
</section>

<section class="panel module-panel">
    <div class="module-head"><h2>Approval Guidelines</h2></div>
    <p>Manager approval is required before PPPoE creation, plan changes, suspension, reactivation, termination, or deletion. Approved requests and actual MikroTik provisioning results are tracked separately. Request notifications go to all Managers.</p>
    <p class="module-note">
        @if (Model.IsManager)
        {
            <text>Open a request to approve or reject it. A request can be decided once.</text>
        }
        else
        {
            <text>Only Managers can approve or reject. You can follow the status of every request here.</text>
        }
        Sending approved changes to MikroTik is added with the router connection; until then they show as "Not sent to router".
    </p>
</section>
