{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Path": "logs/api",
      "LogLevel": {
        "Default": "Warning",
        "Netora.Activity": "Information",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
        "Microsoft.AspNetCore.Diagnostics.DeveloperExceptionPageMiddleware": "None"
      }
    }
  },
  "Jwt": {
    "Issuer": "Netora.WebApi",
    "Audience": "Netora.WebUI",
    "LifetimeMinutes": 480
  },
  "Swagger": {
    "Enabled": false
  },
  "AllowedHosts": "*",
  "Attachments": {
    "StoragePath": "App_Data/attachments",
    "MaxFileSizeBytes": 10485760
  },
  "Router": {
    "Mode": "Mock",
    "TimeoutSeconds": 10,
    "Mock": {
      "StatePath": "App_Data/mock-router.json",
      "FailWrites": false
    }
  },
  "DataProtection": {
    "KeysPath": "App_Data/keys"
  },
  "Email": {
    "Enabled": false,
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseSsl": true,
      "TimeoutSeconds": 30
    },
    "From": "",
    "FromName": "Netora",
    "AppBaseUrl": ""
  }
}
