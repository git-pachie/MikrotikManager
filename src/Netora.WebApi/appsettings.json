{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "Netora.WebApi",
    "Audience": "Netora.WebUI",
    "LifetimeMinutes": 480
  },
  "Swagger": {
    "Enabled": false
  },
  "AllowedHosts": "*",
  "Attachments": {
    "StoragePath": "App_Data/attachments",
    "MaxFileSizeBytes": 10485760
  },
  "DataProtection": {
    "KeysPath": "App_Data/keys"
  }
}
